plugins {
    id 'net.neoforged.gradle.userdev' version '7.0.163'
    id 'java'
}

version = "1.1.6-hotfix"
group = "com.tacz"
archivesBaseName = "tacz-1.21.1"

java.toolchain.languageVersion = JavaLanguageVersion.of(21)

repositories {
    maven {
        // 阿里云镜像，方便国内开发
        url = uri("https://maven.aliyun.com/repository/public/")
        content {
            includeGroup 'org.apache.commons'
        }
    }
    maven {
        // location of the maven that hosts JEI files since January 2023
        // Patchouli
        name = "Jared's maven"
        url = "https://maven.blamejared.com/"
    }
    maven {
        // location of a maven mirror for JEI files, as a fallback
        name = "Mod Maven"
        url = "https://modmaven.k-4u.nl"
    }
    maven {
        url "https://cursemaven.com"
        content {
            includeGroup "curse.maven"
        }
    }
    maven { url "https://maven.shedaniel.me/" } // cloth config api
    maven { url "https://dvs1.progwml6.com/files/maven/" }
    maven { url "https://modmaven.dev" }
    maven {
        name = 'tterrag maven'
        url = 'https://maven.tterrag.com/'
    }
    maven {
        // Shedaniel's maven (Architectury API)
        url = "https://maven.architectury.dev"
        content {
            includeGroup "dev.architectury"
        }
    }
    maven {
        // latvian.dev Maven (KubeJS and Rhino)
        url "https://maven.latvian.dev/releases"
        content {
            includeGroup "dev.latvian.mods"
            includeGroup "dev.latvian.apps"
        }
    }
    maven {
        url 'https://jitpack.io'
        content {
            includeGroup "com.github.rtyley"
            includeGroup "com.github.FiguraMC.luaj"
        }
    }
    maven {
        name "KosmX's maven"
        url 'https://maven.kosmx.dev/'
    }
    mavenCentral() // MixinExtras is there
    mavenLocal()
    flatDir {
        dir 'libs'
    }
}

// FASE 0: Bloco minecraft será adicionado na Fase 1 após resolver dependências básicas
// minecraft {
//     mappings channel: 'official', version: '1.21.1'
//     ... configuração será adicionada depois
// }

sourceSets.main.resources { srcDir 'src/generated/resources' }

dependencies {
    implementation "net.neoforged:neoforge:${neoforge_version}"

    // Apache Commons Math 库，用于进行一些插值运算
    jarJar('org.apache.commons:commons-math3:3.6.1') {
        jarJar.ranged(it, "[3.6.1,)")
    }

    // LuaJ 库，将 lua 脚本语言引入用于控制枪械的逻辑和动画状态机
    jarJar('com.github.FiguraMC.luaj:luaj-core:3.0.8-figura') {
        exclude group: 'org.apache.commons', module: 'commons-lang3'
        jarJar.ranged(it, "[3.0.8,)")
    }
    jarJar('com.github.FiguraMC.luaj:luaj-jse:3.0.8-figura') {
        exclude group: 'org.apache.commons', module: 'commons-lang3'
        jarJar.ranged(it, "[3.0.8,)")
    }
    jarJar('org.apache.bcel:bcel:6.6.1') {
        exclude group: 'org.apache.commons', module: 'commons-lang3'
        jarJar.ranged(it, "[6.6.1,)")
    }

    // compile against the JEI API but do not include it at runtime
    compileOnly("mezz.jei:jei-${minecraft_version}-common-api:${jei_version}")
    compileOnly("mezz.jei:jei-${minecraft_version}-neoforge-api:${jei_version}")
    // at runtime, use the full JEI jar for NeoForge
    runtimeOnly("mezz.jei:jei-${minecraft_version}-neoforge:${jei_version}")
    
    // Cloth Config for NeoForge
    implementation "me.shedaniel.cloth:cloth-config-neoforge:${cloth_config_version}"

    // Commented out dependencies that need updating for 1.21.1
    // 性能分析工具模组 - update for 1.21.1 when available
    // runtimeOnly "curse.maven:spark-361579:4738952"
    
    // 假人，测试近战伤害 - update for 1.21.1 when available
    // runtimeOnly "curse.maven:selene-499980:5478857"
    // runtimeOnly "curse.maven:mmmmmmmmmmmm-225738:5319203"
    
    // 手柄按键支持 - update for 1.21.1 when available
    // implementation "curse.maven:framework-549225:4718251"
    // compileOnly("curse.maven:controllable-317269:4598985")

    // 越肩视角，用来兼容第三人称准星 - update for 1.21.1 when available
    // implementation "curse.maven:shoulder-surfing-reloaded-243190:5455954"

    // Embeddium/Oculus - update for 1.21.1 when available
    // compileOnly "curse.maven:embeddium-908741:${embeddedt_id}"
    
    // Carry On - update for 1.21.1 when available
    // runtimeOnly "curse.maven:carry-on-274259:${carry_on_id}"

    // Player Animation Lib - update for 1.21.1 when available
    // implementation "dev.kosmx.player-anim:player-animation-lib-neoforge:${player_animation_lib}"

    // kubejs开发环境引入 - update for 1.21.1 when available
    // compileOnly "dev.latvian.mods:kubejs-neoforge:${kubejs_version}"
    // compileOnly "dev.latvian.mods:rhino-forge:${rhino_version}"
    // compileOnly "dev.architectury:architectury-neoforge:${architectury_version}"

    // Note: NeoForge 1.21.1 already includes MixinExtras, no need to jar-in-jar
}

jar {
    // 打包时，给 manifest 文件写入一些有用信息
    // 这些信息会被游戏调用，从而显示成模组的名称和版本信息
    manifest {
        attributes([
                "Implementation-Title"  : project.name,
                "Implementation-Version": project.version
        ])
    }
}

java {
    // 编译源码文件，方便发布 maven
    withSourcesJar()
}

tasks.withType(JavaCompile).configureEach {
    options.encoding = 'UTF-8'
}
